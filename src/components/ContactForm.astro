---
import { getCollection } from 'astro:content';
import { getSettings, url } from '../lib/site';
const s = await getSettings();
const f = s.contactForm;
const servicios = await getCollection('servicios');
// web3forms: el mail de destino es el asociado al access key (se cambia en web3forms.com).
// cloudflare: el destino es f.recipient, lo lee functions/api/contacto.ts.
const action = f.provider === 'web3forms' ? 'https://api.web3forms.com/submit' : url('/api/contacto');
const redirect = new URL(url('/gracias'), Astro.site).href;
const input = 'mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 focus:outline-none';
---
<form data-contact-form method="POST" action={action} class="grid gap-4 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
  {f.provider === 'web3forms' && <input type="hidden" name="access_key" value={f.web3formsKey} />}
  <input type="hidden" name="subject" value={f.subject} />
  <input type="hidden" name="from_name" value={`Web ${s.businessName}`} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
  <label class="text-sm font-medium">Nombre y apellido
    <input class={input} name="nombre" required autocomplete="name" />
  </label>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="text-sm font-medium">Teléfono o celular
      <input class={input} name="telefono" type="tel" required autocomplete="tel" placeholder="09X XXX XXX" />
    </label>
    <label class="text-sm font-medium">Barrio o localidad
      <input class={input} name="zona" required placeholder="Ej.: Malvín, Solymar" />
    </label>
  </div>
  <label class="text-sm font-medium">¿Qué hay que reparar?
    <select class={input} name="equipo" required>
      {servicios.map((sv) => <option>{sv.data.shortName}</option>)}
      <option>Otro</option>
    </select>
  </label>
  <label class="text-sm font-medium">Contanos la falla (marca y modelo si los sabés)
    <textarea class={input} name="mensaje" rows="4" required></textarea>
  </label>
  <label class="flex items-start gap-2 text-xs text-slate-600">
    <input type="checkbox" required class="mt-0.5" />
    <span>Acepto que usen mis datos solo para responder esta consulta, según la <a class="underline" href={url('/privacidad')}>política de privacidad</a> (Ley 18.331).</span>
  </label>
  <button type="submit" class="btn-primary">Pedir visita sin costo</button>
  <p data-form-status role="status" class="text-sm"></p>
</form>

<script is:inline define:vars={{ successMessage: f.successMessage }}>
  document.querySelectorAll('form[data-contact-form]').forEach((form) => {
    const status = form.querySelector('[data-form-status]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = successMessage;
        status.className = 'text-sm text-green-700';
        window.gtag?.('event', 'generate_lead', { method: 'form' });
        window.fbq?.('track', 'Lead');
      } catch {
        status.textContent = 'No pudimos enviar el formulario. Probá por WhatsApp o llamanos.';
        status.className = 'text-sm text-red-700';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
