---
import { getSettings, url } from '../lib/site';
const s = await getSettings();
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section aria-labelledby="zonas-title" class="container-x py-16">
  <h2 id="zonas-title" class="text-3xl font-extrabold text-brand-900">Zonas donde vamos en el día</h2>
  <p class="mt-2 text-slate-600">{s.coverage}</p>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {s.zones.map((z) => (
      <div class="rounded-2xl p-6 ring-1 ring-slate-200">
        <h3 class="font-bold text-brand-900">{z.name}</h3>
        <p class="mt-2 text-sm text-slate-600">{(compact ? z.areas.slice(0, 8) : z.areas).join(', ')}{compact && z.areas.length > 8 ? ' y más' : ''}.</p>
      </div>
    ))}
  </div>
  {compact && <p class="mt-6"><a class="font-semibold text-brand-600 underline" href={url('/zonas')}>Ver todas las zonas</a></p>}
</section>
