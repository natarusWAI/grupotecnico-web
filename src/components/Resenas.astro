---
import { getSettings } from '../lib/site';
const s = await getSettings();
// Sin datos estructurados de Review: Google no muestra estrellas para reseñas publicadas por el propio negocio.
---
{s.reviews.length > 0 && (
  <section class="bg-slate-50 py-16" aria-labelledby="resenas-title">
    <div class="container-x">
      <h2 id="resenas-title" class="text-3xl font-extrabold text-brand-900">Lo que dicen nuestros clientes</h2>
      <p class="mt-2 text-slate-600">Reseñas de clientes en Google.</p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {s.reviews.map((r) => (
          <li class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <p class="text-lg tracking-wide text-accent-500" role="img" aria-label={`${r.rating} de 5 estrellas`}>{'★'.repeat(r.rating)}<span class="text-slate-300">{'★'.repeat(5 - r.rating)}</span></p>
            <blockquote class="mt-3 grow text-slate-700">“{r.text}”</blockquote>
            <p class="mt-4 text-sm font-semibold text-brand-900">{r.name}{r.area && <span class="font-normal text-slate-500"> · {r.area}</span>}</p>
          </li>
        ))}
      </ul>
      {s.social.googleBusiness && (
        <p class="mt-8"><a class="font-semibold text-brand-600 underline underline-offset-2" href={s.social.googleBusiness} target="_blank" rel="noopener">Ver todas las reseñas en Google</a></p>
      )}
    </div>
  </section>
)}
