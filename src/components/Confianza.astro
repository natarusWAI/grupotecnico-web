---
import { getSettings, yearsExperience } from '../lib/site';
const s = await getSettings();
// Íconos en trazo simple (sin logos de DGI ni de Mercado Pago).
const items = [
  { title: `${yearsExperience(s.foundingYear)} años de experiencia`, text: `Reparando en Montevideo desde ${s.foundingYear}`, icon: 'M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { title: 'Garantía por escrito', text: '1 o 2 años según el repuesto', icon: 'M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3zM9 12l2 2 4-4' },
  { title: 'Factura electrónica', text: 'En todas las reparaciones', icon: 'M7 3h10v18l-2.5-1.5L12 21l-2.5-1.5L7 21V3zM10 8h4M10 12h4' },
  { title: 'Mercado Pago', text: 'También efectivo o transferencia', icon: 'M3 7h18v10H3zM3 11h18M7 15h3' },
];
---
<section aria-label="Por qué confiar en nosotros" class="border-b border-slate-200 bg-white">
  <ul class="container-x grid grid-cols-2 gap-x-4 gap-y-5 py-6 md:grid-cols-4">
    {items.map((i) => (
      <li class="flex items-start gap-3">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 h-7 w-7 shrink-0 stroke-brand-600" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={i.icon} /></svg>
        <div>
          <p class="leading-tight font-bold text-brand-900">{i.title}</p>
          <p class="mt-0.5 text-sm text-slate-600">{i.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
