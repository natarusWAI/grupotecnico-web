---
interface Props { faqs: { q: string; a: string }[]; title?: string }
const { faqs, title = 'Preguntas frecuentes' } = Astro.props;
---
<section aria-labelledby="faq-title" class="container-x py-16">
  <h2 id="faq-title" class="text-3xl font-extrabold text-brand-900">{title}</h2>
  <div class="mt-6 divide-y divide-slate-200 rounded-2xl ring-1 ring-slate-200">
    {faqs.map((f) => (
      <details class="group p-5">
        <summary class="cursor-pointer list-none font-semibold text-slate-900 group-open:text-brand-700">{f.q}</summary>
        <p class="mt-2 text-slate-700">{f.a}</p>
      </details>
    ))}
  </div>
</section>
