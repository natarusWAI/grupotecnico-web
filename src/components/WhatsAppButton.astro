---
import { getSettings, whatsappLink } from '../lib/site';
const { whatsapp } = await getSettings();
---
{whatsapp.enabled && (
  <a
    href={whatsappLink(whatsapp.number, whatsapp.message)}
    target="_blank"
    rel="noopener"
    aria-label={whatsapp.label}
    class="fixed right-4 bottom-4 z-50 flex items-center gap-2 rounded-full bg-whatsapp px-4 py-3 font-semibold text-white shadow-lg transition hover:scale-105 sm:right-6 sm:bottom-6"
  >
    <svg aria-hidden="true" viewBox="0 0 32 32" class="h-6 w-6 fill-current"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3c.2.2 2.2 3.4 5.4 4.8 2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5s.3-1.3.2-1.5-.3-.2-.6-.4z"/></svg>
    <span class="hidden sm:inline">{whatsapp.label}</span>
  </a>
)}
