---
import { getCollection } from 'astro:content';
import { getSettings, url, telLink } from '../lib/site';
const s = await getSettings();
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const mainPhone = s.phones.find((p) => p.label !== 'Fijo') ?? s.phones[0];
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={url('/')} class="shrink-0">
      <img src={url('/uploads/logo.webp')} alt={s.businessName} width="187" height="40" class="h-8 w-auto sm:h-10" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-6 text-sm font-medium md:flex">
      {servicios.map((sv) => <a class="hover:text-brand-600" href={url(`/${sv.id}`)}>{sv.data.shortName}</a>)}
      <a class="hover:text-brand-600" href={url('/zonas')}>Zonas</a>
      <a class="hover:text-brand-600" href={url('/blog')}>Blog</a>
      <a class="hover:text-brand-600" href={url('/#contacto')}>Contacto</a>
    </nav>
    <div class="flex items-center gap-2">
      {mainPhone && (
        <a href={telLink(mainPhone.number)} class="btn-primary px-4 py-2 text-sm">
          Llamar<span class="hidden sm:inline">{mainPhone.number}</span>
        </a>
      )}
      <!-- Menú móvil sin JavaScript: <details> abre y cierra solo. -->
      <details class="group relative md:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg ring-1 ring-slate-300 [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 stroke-current" fill="none" stroke-width="2" stroke-linecap="round">
            <path class="group-open:hidden" d="M4 6h16M4 12h16M4 18h16" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <nav aria-label="Principal móvil" class="absolute right-0 mt-2 grid w-56 rounded-xl bg-white p-2 text-base font-medium shadow-lg ring-1 ring-slate-200">
          {servicios.map((sv) => <a class="rounded-lg px-3 py-2 hover:bg-brand-50" href={url(`/${sv.id}`)}>{sv.data.shortName}</a>)}
          <a class="rounded-lg px-3 py-2 hover:bg-brand-50" href={url('/zonas')}>Zonas</a>
          <a class="rounded-lg px-3 py-2 hover:bg-brand-50" href={url('/blog')}>Blog</a>
          <a class="rounded-lg px-3 py-2 hover:bg-brand-50" href={url('/#contacto')}>Contacto</a>
        </nav>
      </details>
    </div>
  </div>
</header>
