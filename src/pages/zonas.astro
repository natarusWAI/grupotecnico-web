---
import Base from '../layouts/Base.astro';
import Zonas from '../components/Zonas.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSettings } from '../lib/site';
const s = await getSettings();
---
<Base title="Zonas de servicio técnico a domicilio | Grupo Técnico" description={`Vamos en el día. ${s.coverage}`}>
  <section class="container-x pt-14">
    <h1 class="text-4xl font-extrabold text-brand-900">Zonas de cobertura</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Reparamos lavarropas, secarropas y heladeras a domicilio. {s.coverage} Si tu barrio no aparece, escribinos igual y te confirmamos.</p>
  </section>
  <Zonas />
  <section class="container-x max-w-2xl"><ContactForm /></section>
</Base>
