---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Diferenciales from '../components/Diferenciales.astro';
import Confianza from '../components/Confianza.astro';
import Faq from '../components/Faq.astro';
import Resenas from '../components/Resenas.astro';
import Zonas from '../components/Zonas.astro';
import { getSettings, url, whatsappLink, telLink, yearsExperience } from '../lib/site';

const s = await getSettings();
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const mainPhone = s.phones.find((p) => p.label !== 'Fijo') ?? s.phones[0];

const faqs = [
  { q: '¿La visita tiene costo?', a: 'No. La visita y el presupuesto son sin costo. Solo pagás si aprobás la reparación.' },
  { q: '¿Venden repuestos?', a: 'No. Somos un servicio técnico: hacemos la reparación completa con repuestos originales y garantía.' },
  { q: '¿Hasta dónde van?', a: s.coverage },
  { q: '¿Se llevan el equipo para repararlo?', a: 'No. Reparamos en tu casa, en la misma visita: no retiramos equipos para arreglarlos en un taller.' },
  { q: '¿Qué garantía tienen las reparaciones?', a: s.warranty.text },
  { q: '¿Cómo puedo pagar?', a: 'Con Mercado Pago, efectivo o transferencia. Emitimos factura electrónica.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Reparación de lavarropas y heladeras en Montevideo | Grupo Técnico"
  description="Service de lavarropas, secarropas y heladeras a domicilio. Visita en el día, presupuesto sin costo, repuestos originales y hasta 2 años de garantía."
  jsonLd={[faqLd]}
>
  <section class="relative isolate overflow-hidden bg-brand-900 text-white">
    <!-- En celular la foto casi no se ve bajo el degradado y era el LCP (4 s en PageSpeed): solo se descarga desde md. -->
    <picture>
      <source
        media="(min-width: 768px)"
        srcset={`${url('/uploads/hero-960.webp')} 960w, ${url('/uploads/hero-1920.webp')} 1920w`}
        sizes="100vw"
      />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        width="1920"
        height="1280"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
    </picture>
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-900/95 via-brand-900/85 to-brand-700/70"></div>
    <div class="container-x grid items-center gap-10 py-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="inline-block rounded-full bg-white/10 px-3 py-1 text-xs md:text-sm">Desde {s.foundingYear} en Montevideo: {yearsExperience(s.foundingYear)} años reparando</p>
        <h1 class="mt-3 text-3xl leading-tight font-extrabold md:mt-4 md:text-5xl">Reparamos tu lavarropas, secarropas o heladera <span class="text-accent-500">hoy mismo</span>, en tu casa</h1>
        <p class="mt-3 text-blue-100 md:mt-4 md:text-lg">Visita en el día y presupuesto sin costo. Reparamos en tu casa, con repuestos originales y hasta 2 años de garantía.</p>
        <div class="mt-5 grid gap-3 sm:flex sm:flex-wrap md:mt-8">
          {s.whatsapp.enabled && <a class="btn-whatsapp" href={whatsappLink(s.whatsapp.number, s.whatsapp.message)} target="_blank" rel="noopener">Coordinar por WhatsApp</a>}
          {mainPhone && <a class="btn-ghost" href={telLink(mainPhone.number)}>Llamar al {mainPhone.number}</a>}
        </div>
        <p class="mt-4 text-sm text-blue-100 md:mt-6">{s.hours.text}</p>
      </div>
      <div class="text-slate-800" id="pedir">
        <p class="mb-3 text-lg font-bold text-white">Pedí tu visita sin costo</p>
        <ContactForm />
      </div>
    </div>
  </section>

  <Confianza />

  <section id="servicios" class="container-x py-16" aria-labelledby="serv-title">
    <h2 id="serv-title" class="text-3xl font-extrabold text-brand-900">Qué reparamos</h2>
    <p class="mt-2 text-slate-600">Somos servicio técnico: no vendemos repuestos sueltos. Reparamos tu equipo en tu casa, en la misma visita, con repuestos originales y garantía.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {servicios.map((sv) => (
        <a href={url(`/${sv.id}`)} class="group overflow-hidden rounded-2xl ring-1 ring-slate-200 transition hover:shadow-md hover:ring-brand-600">
          {sv.data.image && (
            <img
              src={url(sv.data.image)}
              srcset={sv.data.image.endsWith('-1200.webp') ? `${url(sv.data.image.replace('-1200.webp', '-600.webp'))} 600w, ${url(sv.data.image)} 1200w` : undefined}
              sizes="(min-width: 768px) 33vw, 100vw"
              width="1200"
              height="800"
              alt=""
              loading="lazy"
              class="aspect-[3/2] w-full object-cover"
            />
          )}
          <div class="p-6">
            <h3 class="text-xl font-bold text-brand-900 group-hover:text-brand-600">{sv.data.title}</h3>
            <p class="mt-2 text-slate-600">{sv.data.intro}</p>
            <ul class="mt-4 grid grid-cols-1 gap-1 text-sm text-slate-700">
              {sv.data.problems.slice(0, 6).map((p) => <li>• {p}</li>)}
            </ul>
            <span class="mt-4 inline-block font-semibold text-brand-600">Ver más →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Diferenciales />

  <Resenas />

  <section class="container-x py-16" aria-labelledby="como-title">
    <h2 id="como-title" class="text-3xl font-extrabold text-brand-900">Así de fácil</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-4">
      {['Nos escribís por WhatsApp o llamás', 'Vamos a tu casa en el día', 'Presupuesto sin costo, sin compromiso', 'Reparamos en tu casa, con garantía y factura'].map((t, i) => (
        <li class="rounded-2xl p-6 ring-1 ring-slate-200"><span class="text-3xl font-extrabold text-brand-600">{i + 1}</span><p class="mt-2 font-medium">{t}</p></li>
      ))}
    </ol>
  </section>

  <section class="bg-slate-50 py-12" aria-labelledby="marcas-title">
    <div class="container-x">
      <h2 id="marcas-title" class="text-center text-2xl font-bold text-brand-900">Trabajamos con todas las marcas</h2>
      <p class="mt-4 text-center text-slate-600">{s.brands.join(' · ')}</p>
    </div>
  </section>

  <Zonas compact />

  {posts.length > 0 && (
    <section class="container-x py-8" aria-labelledby="blog-title">
      <h2 id="blog-title" class="text-3xl font-extrabold text-brand-900">Consejos del técnico</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {posts.map((p) => (
          <a href={url(`/blog/${p.id}`)} class="rounded-2xl p-6 ring-1 ring-slate-200 hover:ring-brand-600">
            <p class="text-xs font-semibold text-brand-600 uppercase">{p.data.category}</p>
            <h3 class="mt-2 font-bold">{p.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <Faq faqs={faqs} />

  <section id="contacto" class="bg-brand-50 py-16" aria-labelledby="contacto-title">
    <div class="container-x grid gap-10 md:grid-cols-2">
      <div>
        <h2 id="contacto-title" class="text-3xl font-extrabold text-brand-900">Contacto</h2>
        <p class="mt-2 text-slate-600">Escribinos y coordinamos la visita en el día.</p>
        <ul class="mt-6 space-y-2">
          {s.phones.map((p) => <li><a class="font-semibold text-brand-700" href={telLink(p.number)}>{p.label}: {p.number}</a></li>)}
          <li><a class="text-brand-700" href={`mailto:${s.email}`}>{s.email}</a></li>
          <li>{s.address.street}, {s.address.city}</li>
          <li>{s.hours.text}</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
